<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- The platform's own passive/exercise/asleep signal: a covariate that says whether a
         heart-rate reading is even about the wearer. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Phase 3: health probe. SHORT_TEXT showing up/down + latency to {server}/v1/health. -->
        <service
            android:name=".complication.HealthComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_health"
            android:label="@string/complication_health"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- Platform floor is ~15 min; 0 would mean "never push updates". -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Phase 4: Component A. Face shows state + elapsed; tap opens the grid. -->
        <service
            android:name=".complication.StateComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_state"
            android:label="@string/complication_state"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- Elapsed ticks via TimeDifferenceComplicationText; refreshes are pushed on tag. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- The 2x4 grid. No launcher intent-filter by design (D7): reachable only from the face. -->
        <activity
            android:name=".ui.TagActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Family-2 owned collection: platform-bound passive listener; batches -> health topic. -->
        <service
            android:name=".health.PassiveDataService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <!-- Family-1 capture: logs Fitbit notifications into the flags stream; body responses
             schedule the delayed tag cue. Bound by the OS; enabled via notification access. -->
        <service
            android:name=".flags.FlagListenerService"
            android:exported="true"
            android:label="wristwork flag listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Rig tap-frame: 6h graphs + top processes. Reachable only from the rig complication. -->
        <activity
            android:name=".ui.RigDetailActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Agents tap-frame: recent finishes per project; chips hand off to the phone. -->
        <activity
            android:name=".ui.AgentsDetailActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Printer tap-frame: job thumbnail + rolling PrusaLink status (5 s refresh while open). -->
        <activity
            android:name=".ui.PrinterDetailActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Choosing what to print. Fetch publishes candidates and slicer numbers; the choosing
             is the wrist's, by the owner's ruling, so this screen is the human half of that loop. -->
        <activity
            android:name=".ui.PrintChooserActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Phase 5: Component B — three instantiations of the generic channel provider. -->
        <service
            android:name=".complication.AgentsComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_agents"
            android:label="@string/complication_agents"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Phase 5: Component B — three instantiations of the generic channel provider. -->
        <service
            android:name=".complication.RigComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_rig"
            android:label="@string/complication_rig"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Phase 5: Component B — three instantiations of the generic channel provider. -->
        <service
            android:name=".complication.PrinterComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_printer"
            android:label="@string/complication_printer"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>
    </application>
</manifest>
